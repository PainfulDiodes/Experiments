ca65 V2.18 - N/A
Main file   : main.s
Current file: main.s

000000r 1               ; Bean65 echo test - blind read of BeanPort status and data, write the data back, loop
000000r 1               ; Build: cl65 -t none -o main.bin main.s
000000r 1               
000000r 1                       .setcpu "6502"
000000r 1               
000000r 1               STATUS  = $7F00                 ; BeanPort status register (A0 = 0)
000000r 1               DATA    = $7F01                 ; BeanPort data register (A0 = 1)
000000r 1               
000000r 1               ; The 8k EEPROM ghosts across the top 32k, so the image is assembled as if at $8000-$9FFF.
000000r 1               ; The CPU's reset vector at $FFFC is read from the same EEPROM byte as $9FFC.
000000r 1               
000000r 1               ROM_START  = $8000              ; start of the 8k image (EEPROM offset $0000)
000000r 1               RESET_VEC  = $9FFC              ; reset vector - read by the CPU as $FFFC
000000r 1               ROM_END    = $A000              ; end of the 8k image (first address after it)
000000r 1               FILL       = $EA                ; padding byte - NOP
000000r 1               
000000r 1                       .org ROM_START
008000  1               
008000  1  AD 00 7F     reset:  LDA STATUS              ; read status (value ignored)
008003  1  AD 01 7F             LDA DATA                ; read data ($00 if nothing waiting)
008006  1  8D 01 7F             STA DATA                ; write it back
008009  1  4C 00 80             JMP reset
00800C  1               
00800C  1               ; Padding: .res count, fill - reserves count bytes of fill.
00800C  1               ; * is the current address, so RESET_VEC - * is the number of bytes from here
00800C  1               ; to the reset vector.
00800C  1               
00800C  1  EA EA EA EA          .res RESET_VEC - *, FILL
008010  1  EA EA EA EA  
008014  1  EA EA EA EA  
009FFC  1               
009FFC  1  00 80                .word reset             ; reset vector
009FFE  1               
009FFE  1  EA EA                .res ROM_END - *, FILL  ; pad to the end of the image
009FFE  1               
